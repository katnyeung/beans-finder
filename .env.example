# PostgreSQL (Neon) Configuration
# Format: jdbc:postgresql://host:port/database
DATABASE_URL=jdbc:postgresql://your-neon-host.neon.tech:5432/coffee_db?sslmode=require
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password

# Alternative: For local PostgreSQL (with Docker Compose)
# DATABASE_URL=jdbc:postgresql://localhost:5432/coffee_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Perplexity API Configuration
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Crawler Configuration
CRAWLER_DELAY_SECONDS=2
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_UPDATE_INTERVAL_DAYS=14
CRAWLER_ENABLED=true

# Server Configuration
SERVER_PORT=8080

# OpenAI API (for product extraction + DALL-E images)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Grok API (for RAG chatbot)
GROK_API_KEY=xai-your_grok_api_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Instagram Platform API (OAuth - works with Creator accounts)
# Get from Meta Developer Portal: https://developers.facebook.com
# Use "Instagram API with Instagram Login" product
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_OAUTH_REDIRECT_URI=https://graphee.link/api/instagram/oauth/callback
